# Which AI provider to use: "mock" (no API key needed) or "gemini" (real
# Google Gemini API calls, requires GEMINI_API_KEY below).
AI_PROVIDER=mock

# Server-side only — never exposed to the browser, never committed to git
# (.env.local is gitignored). Required when AI_PROVIDER=gemini.
# GEMINI_API_KEY=

# Knowledge base retrieval (lib/ai/knowledge/, scripts/index-knowledge.ts).
# Also requires GEMINI_API_KEY above — there is no mock embedding provider.
# Optional overrides; both have working defaults if left unset.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMENSIONS=768
# Minimum cosine similarity (0–1) for a knowledge chunk to be used as
# context. Chunks below it are dropped, so off-topic emails can get none.
# KNOWLEDGE_MIN_SIMILARITY=0.6
# Log the support-scope decision (in/out of scope) server-side in production
# too. Always logged in development.
# DEBUG_SUPPORT_SCOPE=1
