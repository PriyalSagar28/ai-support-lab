# Which AI provider to use. Only "mock" exists in Phase 0 — real providers
# (Anthropic, OpenAI, etc.) will be added in later phases without changing
# any page or API route code.
AI_PROVIDER=mock

# Future real-provider keys go here once added. Server-side only — never
# exposed to the browser, never committed to git (.env.local is gitignored).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
